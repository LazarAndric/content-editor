{
  "name": "@unla4ky/content-editor",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Framework-independent local content editor with localization, media, rich text and XLSX import/export",
  "bin": {
    "content-editor": "./src/cli.mjs",
    "content-kit": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./react": "./src/react.mjs",
    "./live": "./src/live.mjs",
    "./format": "./src/format.mjs",
    "./xlsx": "./src/xlsx.mjs",
    "./xlsx-format": "./src/xlsx-format.mjs",
    "./local": "./src/local.mjs",
    "./server": "./src/server.mjs",
    "./client": "./src/client.mjs",
    "./navigation": "./src/navigation.mjs",
    "./vanilla": "./src/vanilla.mjs",
    "./browser": "./src/browser.mjs",
    "./export-site": "./src/export-site.mjs",
    "./bindings": "./src/bindings.mjs",
    "./fields": "./src/fields.mjs",
    "./diagnostics": "./src/diagnostics.mjs",
    "./navigation-dom": "./src/navigation-dom.mjs",
    "./doctor": "./src/doctor.mjs"
  },
  "files": [
    "src",
    "editor",
    "templates",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "jszip": "3.10.1",
    "marked": "^18.1.1",
    "parse5": "8.0.1",
    "suneditor": "3.4.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LazarAndric/content-editor.git"
  },
  "homepage": "https://github.com/LazarAndric/content-editor#readme",
  "bugs": {
    "url": "https://github.com/LazarAndric/content-editor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "content-editor",
    "localization",
    "i18n",
    "cms",
    "xlsx",
    "vanilla",
    "react"
  ],
  "license": "MIT",
  "author": "Lazar Andric"
}
